{
  "name": "neotask",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test:parity": "node tests/parity.mjs",
    "test:dom": "vite build --config tests/vite.dom.config.js && node tests/dom-parity.mjs",
    "lint": "eslint src",
    "test:factory": "node tests/factory.mjs",
    "test:cars": "node tests/cars.mjs",
    "test": "npm run test:parity && npm run test:factory && npm run test:cars && npm run test:dom"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
